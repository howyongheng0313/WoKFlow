<?xml version="1.0" encoding="utf-8"?>
<appSettings>
  <add key="GeminiApiKey" value="PUT_YOUR_GEMINI_API_KEY_HERE" />
  <add key="GeminiModel" value="gemini-3-flash-preview" />
  <add key="GeminiFallbackModel" value="gemini-3.1-flash-lite" />
  <add key="SmtpHost" value="smtp.gmail.com" />
  <add key="SmtpPort" value="587" />
  <add key="SmtpEnableSsl" value="true" />
  <add key="SmtpUser" value="YOUR_SMTP_USER" />
  <add key="SmtpPass" value="YOUR_SMTP_PASSWORD_OR_APP_PASSWORD" />
  <add key="SmtpFrom" value="wokflow.noreply@gmail.com" />
</appSettings>
